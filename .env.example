# Port Configuration (Default: 8088)
PORT=8088

# Model Context Protocol Security (Optional: leave blank for open local dev)
MCP_API_KEY=

# Google Cloud & Google Workspace Domain-Wide Delegation (Optional for local landing UI)
# Required only if synchronizing live Google Keep, Drive, Docs, Sheets, or Gmail
GOOGLE_APPLICATION_CREDENTIALS="./.service-account.json"
SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
ADMIN_EMAIL="admin@your-domain.com"
USER_EMAIL="user@your-domain.com"
